<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#96FDA2"
    android:fillViewport="true"
    tools:context=".CreateRecord">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Título de la pantalla -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="24dp"
            android:gravity="center"
            android:text="Crear Nuevo Registro"
            android:textColor="#373737"
            android:textSize="22sp"
            android:textStyle="bold" />

        <!-- Campo: Título -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:text="Título:"
            android:textColor="#373737"
            android:textSize="14sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etTitulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="#FFFFFF"
            android:hint="Ej. Medición de campo"
            android:inputType="textCapSentences"
            android:padding="12dp"
            android:textSize="16sp" />

        <!-- Campo: Descripción -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:text="Descripción:"
            android:textColor="#373737"
            android:textSize="14sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etDescripcion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="#FFFFFF"
            android:gravity="top|start"
            android:hint="Ingrese detalles o notas..."
            android:inputType="textMultiLine"
            android:lines="3"
            android:padding="12dp"
            android:textSize="16sp" />

        <!-- Campo: Categoría (Spinner) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:text="Categoría:"
            android:textColor="#373737"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/spinnerCategoria"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="16dp"
            android:background="#FFFFFF"
            android:padding="8dp" />

        <!-- Campo: Fecha y Hora -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:text="Fecha y Hora:"
            android:textColor="#373737"
            android:textSize="14sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etFechaHora"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="#FFFFFF"
            android:hint="dd/MM/yyyy HH:mm"
            android:inputType="none"
            android:padding="12dp"
            android:textSize="16sp" />

        <!-- Campo: Coordenadas (Latitud y Longitud) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:text="Coordenadas GPS:"
            android:textColor="#373737"
            android:textSize="14sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/etLatitud"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:background="#EFEFEF"
                android:hint="Latitud (GPS)"
                android:inputType="numberDecimal|numberSigned"
                android:padding="12dp"
                android:textSize="15sp" />

            <EditText
                android:id="@+id/etLongitud"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="#EFEFEF"
                android:hint="Longitud (GPS)"
                android:inputType="numberDecimal|numberSigned"
                android:padding="12dp"
                android:textSize="15sp" />
        </LinearLayout>

        <!-- Botón: Guardar Registro -->
        <Button
            android:id="@+id/btnGuardar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:backgroundTint="#3C97FF"
            android:paddingVertical="15dp"
            android:text="Guardar Registro"
            android:textColor="#FFFFFF"
            android:textSize="17sp" />

        <!-- Botón: Volver -->
        <Button
            android:id="@+id/btnVolver"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:backgroundTint="#EFFFEA"
            android:paddingVertical="15dp"
            android:text="Volver al Menú"
            android:textColor="#373737"
            android:textSize="17sp" />

        <ProgressBar
            android:id="@+id/progressBar5"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:layout_marginBottom="16dp"
            android:indeterminate="true"/>

    </LinearLayout>
</ScrollView>